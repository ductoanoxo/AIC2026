AIC_DATASET_DIR=../Feature_Dataset
AIC_INDEX_DIR=./storage
AIC_BATCH_PREFIX=L30_
AIC_CLIP_MODEL=ViT-B-32-quickgelu
AIC_CLIP_PRETRAINED=openai
AIC_CORS_ORIGINS=http://localhost:5173
# GEMINI_API_KEY is read from the repository-level .env. It accepts one key,
# a comma-separated list, or a JSON array such as ["key1", "key2"].
AIC_TRANSLATION_MODEL=gemini-3.6-flash
AIC_QA_MODEL=google/gemini-3-flash-preview
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_API_KEY=replace_with_a_new_key
AIC_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
AIC_OPENROUTER_GEMINI_MODEL=google/gemini-3-flash-preview
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
